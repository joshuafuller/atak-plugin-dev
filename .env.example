# Copy to .env and edit. Nothing here is secret; it is machine layout.

# Where you unzipped the ATAK CIV SDK. It must be the folder that directly
# contains atak.apk, android_keystore and atak-gradle-takdev.jar.
# Download it yourself from https://tak.gov — it is licensed and is
# deliberately not baked into the image.
ATAK_SDK_DIR=/home/you/development/tak/ATAK-CIV-5.8.0.1-SDK

# Your host's adb key directory, so the emulator does not re-prompt to
# authorise the container. Defaults to $HOME/.android.
#ANDROID_USER_HOME=/home/you/.android

# How the container reaches the host's adb server. The default works on
# WSL2 / Docker Desktop. On native Linux Docker try tcp:127.0.0.1:5037.
#ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
